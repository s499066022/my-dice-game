# DnD 工具箱 - 开发环境变量（npm run dev）
# 本地开发：/api 走 Vite 代理到本机 Laravel(12226)；WS 经 nginx 反代 /app 到本地 Reverb
# （先 docker exec docker_base-php8 php artisan reverb:start --host=0.0.0.0 --port=8080）
# WS host 默认跟随页面 hostname（同机 localhost、局域网其它设备用 后端主机IP:5173 访问即自动连对）；
# 需要显式指定（如线上 106.12.131.21）时再打开下行：
# VITE_REVERB_HOST=106.12.131.21
# 联调线上：VITE_API_PROXY=http://106.12.131.21:12226 npm run dev
VITE_API_BASE=/api
VITE_REVERB_APP_KEY=163b438a069828cd1dd3dc585a607eab
VITE_REVERB_SCHEME=http
