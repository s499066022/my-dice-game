# DnD 工具箱 - 开发环境变量（npm run dev）
# 开发走 Vite 同源代理：/api -> VITE_API_PROXY（默认本机 12226；联调远程后端时
# 用 VITE_API_PROXY=http://106.12.131.21:12226 npm run dev 启动）。
# 这样 PATCH/DELETE/auth 全部同源转发，不受后端 CORS 限制；WS 仍直连 Reverb。
VITE_API_BASE=/api
# Laravel Reverb（Pusher 协议）连接参数
VITE_REVERB_APP_KEY=163b438a069828cd1dd3dc585a607eab
VITE_REVERB_HOST=106.12.131.21
VITE_REVERB_PORT=12226
VITE_REVERB_SCHEME=http
